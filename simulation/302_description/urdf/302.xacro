<?xml version="1.0" ?>
<robot name="302" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:include filename="$(find 302_description)/urdf/materials.xacro" />
<xacro:include filename="$(find 302_description)/urdf/302.trans" />
<xacro:include filename="$(find 302_description)/urdf/302.gazebo" />
<link name="base_link">
  <inertial>
    <origin xyz="0.05 0.001 -0.05" rpy="0 0 0"/>
    <mass value="0.15699999999999997"/>
    <inertia ixx="0.000131" iyy="0.000262" izz="0.000131" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find 302_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find 302_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="second_1">
  <inertial>
    <origin xyz="-0.048958750026855714 0.0010000000000000009 0.04965131500378102" rpy="0 0 0"/>
    <mass value="0.1253745935745986"/>
    <inertia ixx="0.000118" iyy="0.000233" izz="0.000115" ixy="0.0" iyz="0.0" ixz="-3e-06"/>
  </inertial>
  <visual>
    <origin xyz="-0.1 -0.002 0.1" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find 302_description)/meshes/second_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="-0.1 -0.002 0.1" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find 302_description)/meshes/second_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<joint name="Starr 1" type="fixed">
  <origin xyz="0.1 0.002 -0.1" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="second_1"/>
</joint>

</robot>
