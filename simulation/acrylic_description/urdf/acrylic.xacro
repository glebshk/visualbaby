<?xml version="1.0" ?>
<robot name="acrylic" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:include filename="$(find acrylic_description)/urdf/materials.xacro" />
<xacro:include filename="$(find acrylic_description)/urdf/acrylic.trans" />
<xacro:include filename="$(find acrylic_description)/urdf/acrylic.gazebo" />
<link name="base_link">
  <inertial>
    <origin xyz="1.0087887694718944 0.5663931957634041 0.022990070801923904" rpy="0 0 0"/>
    <mass value="4465.926073232328"/>
    <inertia ixx="2005.148123" iyy="1815.734898" izz="3554.582357" ixy="-18.432065" iyz="-56.736229" ixz="-1.06014"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find acrylic_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find acrylic_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

</robot>
