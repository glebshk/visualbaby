<?xml version="1.0" ?>
<robot name="obstacle" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:include filename="$(find obstacle_description)/urdf/materials.xacro" />
<xacro:include filename="$(find obstacle_description)/urdf/obstacle.trans" />
<xacro:include filename="$(find obstacle_description)/urdf/obstacle.gazebo" />
<link name="base_link">
  <inertial>
    <origin xyz="0.22577259205520697 0.8089599807171871 -0.23272589723929793" rpy="0 0 0"/>
    <mass value="1048.516674142054"/>
    <inertia ixx="381.180728" iyy="16.049352" izz="381.753033" ixy="-0.175009" iyz="1.750082" ixz="0.001842"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find obstacle_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find obstacle_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

</robot>
