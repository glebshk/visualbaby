<?xml version="1.0" ?>
<robot name="300" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:include filename="$(find 300_description)/urdf/materials.xacro" />
<xacro:include filename="$(find 300_description)/urdf/300.trans" />
<xacro:include filename="$(find 300_description)/urdf/300.gazebo" />
<link name="base_link">
  <inertial>
    <origin xyz="0.05 0.001 -0.05" rpy="0 0 0"/>
    <mass value="0.15699999999999997"/>
    <inertia ixx="0.000131" iyy="0.000262" izz="0.000131" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find 300_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find 300_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="second_1_1">
  <inertial>
    <origin xyz="-0.04847202707133871 0.0010000000000000005 0.04884893710070204" rpy="0 0 0"/>
    <mass value="0.11586545266918254"/>
    <inertia ixx="0.000114" iyy="0.000226" izz="0.000112" ixy="-0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.1 -0.002 0.1" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find 300_description)/meshes/second_1_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="-0.1 -0.002 0.1" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find 300_description)/meshes/second_1_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<joint name="Starr 1" type="fixed">
  <origin xyz="0.1 0.002 -0.1" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="second_1_1"/>
</joint>

</robot>
