<?xml version="1.0" ?>
<robot name="container" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:include filename="$(find container_description)/urdf/materials.xacro" />
<xacro:include filename="$(find container_description)/urdf/container.trans" />
<xacro:include filename="$(find container_description)/urdf/container.gazebo" />
<link name="base_link">
  <inertial>
    <origin xyz="0.19503083481525813 0.04620357923038145 -0.15922844866167055" rpy="0 0 0"/>
    <mass value="52.554768749999994"/>
    <inertia ixx="0.625788" iyy="1.451598" izz="0.993736" ixy="0.009479" iyz="0.017604" ixz="0.004108"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find container_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find container_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

</robot>
