<?xml version="1.0" ?>
<robot name="Dell" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:include filename="$(find Dell_description)/urdf/materials.xacro" />
<xacro:include filename="$(find Dell_description)/urdf/Dell.trans" />
<xacro:include filename="$(find Dell_description)/urdf/Dell.gazebo" />
<link name="base_link">
  <inertial>
    <origin xyz="-0.053706569420959305 0.6019889561776742 0.0004203744708434875" rpy="0 0 0"/>
    <mass value="3335.157991154643"/>
    <inertia ixx="686.433662" iyy="355.592968" izz="484.034453" ixy="-0.872533" iyz="-4e-06" ixz="-1e-06"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find Dell_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find Dell_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="lcd_monitor_1">
  <inertial>
    <origin xyz="0.03164489066478364 0.2475829248887167 0.0004519914313753639" rpy="0 0 0"/>
    <mass value="52.517518364036796"/>
    <inertia ixx="1.693987" iyy="1.239059" izz="0.472214" ixy="0.006546" iyz="0.001352" ixz="0.000165"/>
  </inertial>
  <visual>
    <origin xyz="-0.079768 -1.281416 -0.00042" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find Dell_description)/meshes/lcd_monitor_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="-0.079768 -1.281416 -0.00042" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find Dell_description)/meshes/lcd_monitor_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<joint name="Starr 1" type="fixed">
  <origin xyz="0.079768 1.281416 0.00042" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="lcd_monitor_1"/>
</joint>

</robot>
