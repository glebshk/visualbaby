<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='x500_mono_cam_down'>
    <self_collide>false</self_collide>

    <!-- Include the base x500 model -->
    <include merge='true'>
      <uri>x500</uri>
    </include>

    <!-- Include the first camera -->
    <include merge='true'>
      <uri>model://mono_cam</uri>
      <pose>0 0 .10 0 1.5707 0</pose>
    </include>
    
    <!-- Joint to attach the first camera -->
    <joint name="CameraJoint" type="fixed">
      <parent>base_link</parent>
      <child>mono_cam/base_link</child>
      <pose relative_to="base_link">0 0 0 0 1.5707 0</pose>
    </joint>

    <!-- Include the second camera -->
    <include merge='true'>
      <uri>model://mono_cam_forward</uri>
      <pose>.2 0 .242 0 0 0</pose>
    </include>

    <!-- Joint to attach the second camera -->
    <joint name="CameraJoint2" type="fixed">
      <parent>base_link</parent>
      <child>mono_cam_forward/base_link</child>
      <pose relative_to="base_link">.2 0 .242 0 0 0</pose>
    </joint>
  </model>
</sdf>