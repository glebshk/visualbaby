<?xml version="1.0" ?>
<robot name="100" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:include filename="$(find 100_description)/urdf/materials.xacro" />
<xacro:include filename="$(find 100_description)/urdf/100.trans" />
<xacro:include filename="$(find 100_description)/urdf/100.gazebo" />
<link name="base_link">
  <inertial>
    <origin xyz="0.04999999999999999 0.001 -0.05" rpy="0 0 0"/>
    <mass value="0.15699999999999995"/>
    <inertia ixx="0.000131" iyy="0.000262" izz="0.000131" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find 100_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find 100_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="second_link_1">
  <inertial>
    <origin xyz="-0.04927974363105341 0.0010000000000000009 0.050003272214828844" rpy="0 0 0"/>
    <mass value="0.12484629145681776"/>
    <inertia ixx="0.00012" iyy="0.000237" izz="0.000117" ixy="0.0" iyz="0.0" ixz="1e-06"/>
  </inertial>
  <visual>
    <origin xyz="-0.1 -0.002 0.1" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find 100_description)/meshes/second_link_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="-0.1 -0.002 0.1" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find 100_description)/meshes/second_link_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<joint name="Starr 1" type="fixed">
  <origin xyz="0.1 0.002 -0.1" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="second_link_1"/>
</joint>

</robot>
