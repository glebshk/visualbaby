<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="x500_flow">
    <self_collide>false</self_collide>

    <!-- BASE PLATFORM -->
    <include merge="true">
      <uri>x500</uri>
    </include>

    <include merge="true">
      <uri>model://optical_flow</uri>
      <pose relative_to="base_link">0.05 0 -0.1 0 0 0</pose>
    </include>

    <include merge="true">
      <uri>model://OakD-Lite_down</uri>
      <pose relative_to="base_link">0 0 -0.1 0 1.57 0</pose>
    </include>

    <include merge="true">
      <uri>model://MLX90614</uri>
      <pose relative_to="base_link">-0.05 0 -0.1 0 3.14 0</pose>
    </include>

    <include merge="true">
      <uri>model://OakD-Lite_front</uri>
      <pose relative_to="base_link">0.2 0.03 0 0 0 0</pose>
    </include>

    <!-- ========== JOINTS ========== -->

    <joint name="optical_flow_joint" type="fixed">
      <parent>base_link</parent>
      <child>flow_link</child>
      <pose relative_to="base_link">0.05 0 -0.1 0 0 0</pose>
    </joint>

    <joint name="mono_cam_joint" type="fixed">
      <parent>base_link</parent>
      <child>realsense_down_link</child>
      <pose relative_to="base_link">0 0 -0.1 0 1.57 0</pose>
    </joint>

    <joint name="mlx90614_joint" type="fixed">
      <parent>base_link</parent>
      <child>MLX90614_link</child>
      <pose relative_to="base_link">-0.05 0 -0.1 0 0 0</pose>
    </joint>

    <joint name="oakd_joint" type="fixed">
      <parent>base_link</parent>
      <child>realsense_front_link</child>
      <pose relative_to="base_link">0.1 0.03 0.3 0 0 0</pose>
    </joint>

    <!-- ========== CUSTOM LIDAR ========== -->

    <link name="lidar_sensor_link">
      <pose relative_to="base_link">0 0 -0.05 0 1.57 0</pose>

      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <iyy>0.00001</iyy>
          <izz>0.00001</izz>
        </inertia>
      </inertial>

      <sensor name="lidar" type="gpu_lidar">
        <pose>0 0 0 3.14 0 0</pose>
        <update_rate>50</update_rate>

        <ray>
          <scan>
            <horizontal>
              <samples>1</samples>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.1</min>
            <max>100</max>
          </range>
        </ray>

        <always_on>1</always_on>
        <visualize>true</visualize>
      </sensor>
    </link>

    <joint name="lidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_sensor_link</child>
    </joint>

  </model>
</sdf>